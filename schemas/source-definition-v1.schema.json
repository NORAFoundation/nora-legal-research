{
  "$defs": {
    "AcquisitionMethod": {
      "enum": [
        "BULK_DOWNLOAD",
        "REST_API",
        "WEB_FETCH",
        "MANUAL_PERIODIC"
      ],
      "title": "AcquisitionMethod",
      "type": "string"
    },
    "AcquisitionMode": {
      "enum": [
        "DOWNLOAD_ARCHIVE",
        "JSON_API",
        "HTML_DOCUMENT",
        "XML_FEED",
        "RSS_FEED",
        "PDF_DOWNLOAD"
      ],
      "title": "AcquisitionMode",
      "type": "string"
    },
    "AuthRequirement": {
      "enum": [
        "NONE",
        "OPTIONAL_KEY",
        "REQUIRED_KEY"
      ],
      "title": "AuthRequirement",
      "type": "string"
    },
    "AuthorityFamily": {
      "enum": [
        "CONSTITUTION",
        "STATUTE",
        "ADMINISTRATIVE_CODE",
        "COURT_RULES",
        "JUDICIAL_OPINION",
        "FORMS_GUIDANCE"
      ],
      "title": "AuthorityFamily",
      "type": "string"
    },
    "AuthorityLevel": {
      "enum": [
        "PRIMARY_CONTROLLING",
        "PRIMARY_PERSUASIVE",
        "EXPLANATORY",
        "PROCESS"
      ],
      "title": "AuthorityLevel",
      "type": "string"
    },
    "AvailabilityStatus": {
      "enum": [
        "AVAILABLE",
        "RESTRICTED",
        "UNSTABLE",
        "PLANNED"
      ],
      "title": "AvailabilityStatus",
      "type": "string"
    },
    "CoverageStatus": {
      "enum": [
        "EXPERIMENTAL",
        "BASIC",
        "VERIFIED",
        "DEEP_COVERAGE"
      ],
      "title": "CoverageStatus",
      "type": "string"
    },
    "CurrentnessCapability": {
      "enum": [
        "LIVE_FEED",
        "OFFICIAL_BULLETIN",
        "CITATOR_EXTERNAL",
        "SNAPSHOT_ONLY",
        "NONE"
      ],
      "title": "CurrentnessCapability",
      "type": "string"
    },
    "GeographicScope": {
      "enum": [
        "STATEWIDE",
        "CIRCUIT_7",
        "CIRCUIT_8",
        "FEDERAL_DISTRICT",
        "NATIONAL"
      ],
      "title": "GeographicScope",
      "type": "string"
    },
    "ImplementationStatus": {
      "enum": [
        "PLANNED",
        "IN_PROGRESS",
        "IMPLEMENTED",
        "VERIFIED"
      ],
      "title": "ImplementationStatus",
      "type": "string"
    },
    "LegalDomain": {
      "enum": [
        "JUVENILE_CHILD_WELFARE",
        "CONSTITUTIONAL",
        "CIVIL_RIGHTS",
        "CIVIL_PROCEDURE",
        "APPELLATE_PROCEDURE",
        "EVIDENCE",
        "ADMINISTRATIVE",
        "GENERAL"
      ],
      "title": "LegalDomain",
      "type": "string"
    },
    "OfficialStatus": {
      "enum": [
        "OFFICIAL",
        "UNOFFICIAL"
      ],
      "title": "OfficialStatus",
      "type": "string"
    },
    "UpdateCadence": {
      "enum": [
        "CONTINUOUS",
        "DAILY",
        "WEEKLY",
        "MONTHLY",
        "ANNUAL",
        "BIENNIAL",
        "SESSIONAL",
        "IRREGULAR"
      ],
      "title": "UpdateCadence",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Canonical registry entry for an authoritative legal source or provider.",
  "properties": {
    "acquisition_method": {
      "$ref": "#/$defs/AcquisitionMethod"
    },
    "acquisition_mode": {
      "$ref": "#/$defs/AcquisitionMode"
    },
    "auth_requirement": {
      "$ref": "#/$defs/AuthRequirement",
      "default": "NONE"
    },
    "authority_family": {
      "$ref": "#/$defs/AuthorityFamily"
    },
    "authority_level": {
      "$ref": "#/$defs/AuthorityLevel"
    },
    "availability_status": {
      "$ref": "#/$defs/AvailabilityStatus"
    },
    "canonical_url": {
      "title": "Canonical Url",
      "type": "string"
    },
    "citation_syntax": {
      "items": {
        "type": "string"
      },
      "title": "Citation Syntax",
      "type": "array"
    },
    "coverage_status": {
      "$ref": "#/$defs/CoverageStatus"
    },
    "currentness_capability": {
      "$ref": "#/$defs/CurrentnessCapability"
    },
    "effective_date_semantics": {
      "title": "Effective Date Semantics",
      "type": "string"
    },
    "geographic_scope": {
      "$ref": "#/$defs/GeographicScope"
    },
    "historical_version_capability": {
      "title": "Historical Version Capability",
      "type": "boolean"
    },
    "implementation_status": {
      "$ref": "#/$defs/ImplementationStatus"
    },
    "jurisdiction": {
      "title": "Jurisdiction",
      "type": "string"
    },
    "known_limitations": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Known Limitations",
      "type": "array"
    },
    "last_verified_date": {
      "format": "date",
      "title": "Last Verified Date",
      "type": "string"
    },
    "legal_domain": {
      "$ref": "#/$defs/LegalDomain"
    },
    "licensing_terms_notes": {
      "title": "Licensing Terms Notes",
      "type": "string"
    },
    "official_status": {
      "$ref": "#/$defs/OfficialStatus"
    },
    "parser_normalizer_id": {
      "title": "Parser Normalizer Id",
      "type": "string"
    },
    "provenance_capability": {
      "title": "Provenance Capability",
      "type": "boolean"
    },
    "provider_name": {
      "title": "Provider Name",
      "type": "string"
    },
    "publication_date_semantics": {
      "title": "Publication Date Semantics",
      "type": "string"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "source_name": {
      "title": "Source Name",
      "type": "string"
    },
    "temporal_version_semantics": {
      "title": "Temporal Version Semantics",
      "type": "string"
    },
    "update_cadence": {
      "$ref": "#/$defs/UpdateCadence"
    },
    "verification_evidence": {
      "title": "Verification Evidence",
      "type": "string"
    }
  },
  "required": [
    "source_id",
    "jurisdiction",
    "geographic_scope",
    "legal_domain",
    "authority_family",
    "source_name",
    "provider_name",
    "official_status",
    "authority_level",
    "canonical_url",
    "acquisition_method",
    "acquisition_mode",
    "update_cadence",
    "temporal_version_semantics",
    "effective_date_semantics",
    "publication_date_semantics",
    "parser_normalizer_id",
    "citation_syntax",
    "currentness_capability",
    "historical_version_capability",
    "provenance_capability",
    "licensing_terms_notes",
    "availability_status",
    "implementation_status",
    "coverage_status",
    "last_verified_date",
    "verification_evidence"
  ],
  "title": "SourceDefinition",
  "type": "object"
}
