{
  "$defs": {
    "BenchmarkCorpusRole": {
      "enum": [
        "DEVELOPMENT",
        "VALIDATION",
        "HOLDOUT"
      ],
      "title": "BenchmarkCorpusRole",
      "type": "string"
    },
    "BenchmarkDocument": {
      "additionalProperties": false,
      "description": "Synthetic document associated with a scenario (e.g., notice, petition, text screenshot).",
      "properties": {
        "adversarial_payload_description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adversarial Payload Description"
        },
        "contains_adversarial_instruction": {
          "default": false,
          "title": "Contains Adversarial Instruction",
          "type": "boolean"
        },
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "document_type": {
          "title": "Document Type",
          "type": "string"
        },
        "text_content": {
          "title": "Text Content",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "title",
        "document_type",
        "text_content"
      ],
      "title": "BenchmarkDocument",
      "type": "object"
    },
    "ExpectedCoverageRequirements": {
      "additionalProperties": false,
      "description": "Minimum required dimensional research coverage for a passing result.",
      "properties": {
        "min_adverse_research": {
          "default": 0.5,
          "title": "Min Adverse Research",
          "type": "number"
        },
        "min_controlling_authority": {
          "default": 0.5,
          "title": "Min Controlling Authority",
          "type": "number"
        },
        "min_currentness": {
          "default": 0.5,
          "title": "Min Currentness",
          "type": "number"
        },
        "min_governing_text": {
          "default": 0.5,
          "title": "Min Governing Text",
          "type": "number"
        },
        "min_quote_verification": {
          "default": 0.5,
          "title": "Min Quote Verification",
          "type": "number"
        }
      },
      "title": "ExpectedCoverageRequirements",
      "type": "object"
    },
    "UserSophistication": {
      "enum": [
        "LAY_UNREPRESENTED",
        "LAY_SEEKING_COUNSEL",
        "EXPERIENCED_ADVOCATE"
      ],
      "title": "UserSophistication",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Canonical NORA Bench V1 Scenario contract.",
  "properties": {
    "adversarial_injection_prompt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Adversarial Injection Prompt"
    },
    "authority_verification_notes": {
      "default": [
        "Governing statutory and procedural rule framework verified against official primary sources; substantive case law holding qualification remains pending qualified citator integration."
      ],
      "items": {
        "type": "string"
      },
      "title": "Authority Verification Notes",
      "type": "array"
    },
    "category": {
      "title": "Category",
      "type": "string"
    },
    "contract": {
      "default": "nora.legal-research/BenchmarkScenario/1.0",
      "title": "Contract",
      "type": "string"
    },
    "corpus_role": {
      "$ref": "#/$defs/BenchmarkCorpusRole",
      "default": "DEVELOPMENT"
    },
    "documents": {
      "default": [],
      "items": {
        "$ref": "#/$defs/BenchmarkDocument"
      },
      "title": "Documents",
      "type": "array"
    },
    "domain": {
      "default": "CHILD_WELFARE",
      "title": "Domain",
      "type": "string"
    },
    "expected_adverse_research_requirement": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Expected Adverse Research Requirement",
      "type": "array"
    },
    "expected_clarification_questions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Expected Clarification Questions",
      "type": "array"
    },
    "expected_controlling_authority_characteristics": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Expected Controlling Authority Characteristics",
      "type": "array"
    },
    "expected_coverage": {
      "$ref": "#/$defs/ExpectedCoverageRequirements"
    },
    "expected_epistemic_labels": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Expected Epistemic Labels",
      "type": "array"
    },
    "explicit_user_nominated_theory": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Explicit User Nominated Theory"
    },
    "gold_issue_families": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Gold Issue Families",
      "type": "array"
    },
    "governing_source_families": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Governing Source Families",
      "type": "array"
    },
    "hidden_or_latent_issues": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Hidden Or Latent Issues",
      "type": "array"
    },
    "is_security_adversarial": {
      "default": false,
      "title": "Is Security Adversarial",
      "type": "boolean"
    },
    "jurisdiction": {
      "title": "Jurisdiction",
      "type": "string"
    },
    "known_traps": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Known Traps",
      "type": "array"
    },
    "matter_id": {
      "default": "DEFAULT-MATTER",
      "title": "Matter Id",
      "type": "string"
    },
    "ordinary_language_narrative": {
      "title": "Ordinary Language Narrative",
      "type": "string"
    },
    "procedural_posture": {
      "title": "Procedural Posture",
      "type": "string"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "substantive_gold_authority_pending": {
      "default": true,
      "title": "Substantive Gold Authority Pending",
      "type": "boolean"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "unsupported_conclusions_prohibited": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Unsupported Conclusions Prohibited",
      "type": "array"
    },
    "urgency_or_deadline_facts": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Urgency Or Deadline Facts",
      "type": "array"
    },
    "user_sophistication": {
      "$ref": "#/$defs/UserSophistication"
    }
  },
  "required": [
    "scenario_id",
    "category",
    "title",
    "jurisdiction",
    "user_sophistication",
    "ordinary_language_narrative",
    "procedural_posture"
  ],
  "title": "BenchmarkScenario",
  "type": "object"
}
