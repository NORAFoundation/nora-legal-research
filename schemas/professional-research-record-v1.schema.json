{
  "$defs": {
    "AssessmentStatus": {
      "enum": [
        "VERIFIED",
        "SUPPORTED",
        "UNVERIFIED",
        "UNKNOWN",
        "NOT_AVAILABLE",
        "BLOCKED",
        "CONTRADICTED"
      ],
      "title": "AssessmentStatus",
      "type": "string"
    },
    "AuthorityQualification": {
      "additionalProperties": false,
      "properties": {
        "authority_id": {
          "title": "Authority Id",
          "type": "string"
        },
        "currentness": {
          "$ref": "#/$defs/AssessmentStatus",
          "default": "UNKNOWN"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "hierarchy": {
          "$ref": "#/$defs/AssessmentStatus",
          "default": "UNKNOWN"
        },
        "identity": {
          "$ref": "#/$defs/AssessmentStatus",
          "default": "UNKNOWN"
        },
        "jurisdiction": {
          "$ref": "#/$defs/AssessmentStatus",
          "default": "UNKNOWN"
        },
        "limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "opinion_voice": {
          "$ref": "#/$defs/AssessmentStatus",
          "default": "UNKNOWN"
        },
        "procedural_fit": {
          "$ref": "#/$defs/AssessmentStatus",
          "default": "UNKNOWN"
        },
        "qualification_status": {
          "$ref": "#/$defs/AuthorityQualificationStatus",
          "default": "PROVISIONAL"
        },
        "quote_verification": {
          "$ref": "#/$defs/AssessmentStatus",
          "default": "NOT_AVAILABLE"
        },
        "retrieval": {
          "$ref": "#/$defs/AssessmentStatus",
          "default": "UNKNOWN"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "treatment": {
          "$ref": "#/$defs/AssessmentStatus",
          "default": "UNKNOWN"
        }
      },
      "required": [
        "authority_id"
      ],
      "title": "AuthorityQualification",
      "type": "object"
    },
    "AuthorityQualificationStatus": {
      "enum": [
        "RETRIEVED",
        "PROVISIONAL",
        "QUALIFIED",
        "PARTIAL",
        "BLOCKED"
      ],
      "title": "AuthorityQualificationStatus",
      "type": "string"
    },
    "CompletenessStatus": {
      "enum": [
        "NOT_STARTED",
        "IN_PROGRESS",
        "COMPLETE",
        "PARTIAL",
        "UNKNOWN",
        "BLOCKED"
      ],
      "title": "CompletenessStatus",
      "type": "string"
    },
    "DimensionAssessment": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "title": "Basis",
          "type": "string"
        },
        "blocking_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blocking Reason"
        },
        "dimension": {
          "$ref": "#/$defs/ResearchDimension"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/CompletenessStatus"
        },
        "unresolved_questions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unresolved Questions",
          "type": "array"
        }
      },
      "required": [
        "dimension",
        "status",
        "basis"
      ],
      "title": "DimensionAssessment",
      "type": "object"
    },
    "EpistemicStatus": {
      "enum": [
        "USER_REPORTED",
        "USER_INTERPRETATION",
        "INFERRED",
        "DOCUMENT_REPORTED",
        "PROVIDER_RETRIEVED",
        "PRIMARY_SOURCE_VERIFIED",
        "DISPUTED",
        "UNKNOWN"
      ],
      "title": "EpistemicStatus",
      "type": "string"
    },
    "FactEvidence": {
      "additionalProperties": false,
      "properties": {
        "adverse_to_user_position": {
          "default": false,
          "title": "Adverse To User Position",
          "type": "boolean"
        },
        "epistemic_status": {
          "$ref": "#/$defs/EpistemicStatus"
        },
        "fact_id": {
          "title": "Fact Id",
          "type": "string"
        },
        "materiality": {
          "default": "UNKNOWN",
          "title": "Materiality",
          "type": "string"
        },
        "source_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        },
        "verification_limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Verification Limitations",
          "type": "array"
        }
      },
      "required": [
        "fact_id",
        "statement",
        "epistemic_status"
      ],
      "title": "FactEvidence",
      "type": "object"
    },
    "ProfessionalFinding": {
      "additionalProperties": false,
      "properties": {
        "evidence_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "limitation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limitation"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/EpistemicStatus"
        }
      },
      "required": [
        "finding_id",
        "statement",
        "status"
      ],
      "title": "ProfessionalFinding",
      "type": "object"
    },
    "ResearchCompleteness": {
      "additionalProperties": false,
      "properties": {
        "assessment_id": {
          "title": "Assessment Id",
          "type": "string"
        },
        "blocked_dimensions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ResearchDimension"
          },
          "title": "Blocked Dimensions",
          "type": "array"
        },
        "contract": {
          "default": "nora.legal-research/ResearchQuality/1.0",
          "title": "Contract",
          "type": "string"
        },
        "dimensions": {
          "items": {
            "$ref": "#/$defs/DimensionAssessment"
          },
          "title": "Dimensions",
          "type": "array"
        },
        "overall_status": {
          "$ref": "#/$defs/CompletenessStatus"
        },
        "required_dimensions": {
          "items": {
            "$ref": "#/$defs/ResearchDimension"
          },
          "title": "Required Dimensions",
          "type": "array"
        },
        "research_id": {
          "title": "Research Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "stop_basis": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Stop Basis",
          "type": "array"
        },
        "stopping_rule_met": {
          "default": false,
          "title": "Stopping Rule Met",
          "type": "boolean"
        },
        "unresolved_dimensions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ResearchDimension"
          },
          "title": "Unresolved Dimensions",
          "type": "array"
        }
      },
      "required": [
        "assessment_id",
        "research_id",
        "dimensions",
        "required_dimensions",
        "overall_status"
      ],
      "title": "ResearchCompleteness",
      "type": "object"
    },
    "ResearchDimension": {
      "enum": [
        "JURISDICTION",
        "FACTS",
        "PROCEDURAL_POSTURE",
        "CONTROLLING_AUTHORITY",
        "GOVERNING_TEXT",
        "AUTHORITY_HIERARCHY",
        "ADVERSE_AUTHORITY",
        "LIMITING_AUTHORITY",
        "QUOTE_VERIFICATION",
        "CURRENTNESS_TREATMENT",
        "APPLICATION"
      ],
      "title": "ResearchDimension",
      "type": "string"
    },
    "SourceEvidence": {
      "additionalProperties": false,
      "properties": {
        "epistemic_status": {
          "$ref": "#/$defs/EpistemicStatus",
          "default": "UNKNOWN"
        },
        "limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "provenance": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Provenance",
          "type": "array"
        },
        "public": {
          "default": false,
          "title": "Public",
          "type": "boolean"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "source_type": {
          "$ref": "#/$defs/SourceType"
        },
        "supports_fact_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Supports Fact Ids",
          "type": "array"
        }
      },
      "required": [
        "source_id",
        "source_type"
      ],
      "title": "SourceEvidence",
      "type": "object"
    },
    "SourceType": {
      "enum": [
        "USER_NARRATIVE",
        "USER_DOCUMENT",
        "PRIMARY_AUTHORITY",
        "PROVIDER_METADATA",
        "SECONDARY_SOURCE",
        "REASONING_RECORD"
      ],
      "title": "SourceType",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_qualifications": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AuthorityQualification"
      },
      "title": "Authority Qualifications",
      "type": "array"
    },
    "completeness": {
      "$ref": "#/$defs/ResearchCompleteness"
    },
    "facts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FactEvidence"
      },
      "title": "Facts",
      "type": "array"
    },
    "findings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProfessionalFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "record_id": {
      "title": "Record Id",
      "type": "string"
    },
    "research_id": {
      "title": "Research Id",
      "type": "string"
    },
    "review_required": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Review Required",
      "type": "array"
    },
    "sources": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SourceEvidence"
      },
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "record_id",
    "research_id",
    "completeness"
  ],
  "title": "ProfessionalResearchRecord",
  "type": "object"
}
