{
  "$defs": {
    "OpinionType": {
      "enum": [
        "majority",
        "concurrence",
        "dissent",
        "per_curiam",
        "unknown"
      ],
      "title": "OpinionType",
      "type": "string"
    },
    "ProviderAuthorityCandidate": {
      "additionalProperties": false,
      "properties": {
        "authority_status": {
          "default": "UNKNOWN",
          "title": "Authority Status",
          "type": "string"
        },
        "binding_weight": {
          "default": "UNKNOWN",
          "title": "Binding Weight",
          "type": "string"
        },
        "case_name": {
          "title": "Case Name",
          "type": "string"
        },
        "citation": {
          "title": "Citation",
          "type": "string"
        },
        "court": {
          "title": "Court",
          "type": "string"
        },
        "decision_date": {
          "title": "Decision Date",
          "type": "string"
        },
        "exact_proposition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exact Proposition"
        },
        "metadata": {
          "$ref": "#/$defs/ProviderCandidateMetadata"
        },
        "opinion_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Opinion Id"
        },
        "opinion_type": {
          "$ref": "#/$defs/OpinionType",
          "default": "unknown"
        },
        "procedural_fit": {
          "default": "UNKNOWN",
          "title": "Procedural Fit",
          "type": "string"
        },
        "provider_cluster_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Cluster Id"
        },
        "provider_rank": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Rank"
        },
        "provider_record_id": {
          "title": "Provider Record Id",
          "type": "string"
        },
        "relationship": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relationship"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        }
      },
      "required": [
        "provider_record_id",
        "case_name",
        "citation",
        "court",
        "decision_date"
      ],
      "title": "ProviderAuthorityCandidate",
      "type": "object"
    },
    "ProviderCandidateMetadata": {
      "additionalProperties": false,
      "description": "Small, public-only metadata allowlist emitted by the mirror envelope.",
      "properties": {
        "provider_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Score"
        }
      },
      "title": "ProviderCandidateMetadata",
      "type": "object"
    },
    "ProviderProvenanceModel": {
      "additionalProperties": false,
      "properties": {
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "mirror_git_sha": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mirror Git Sha"
        },
        "native_result_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Result Count"
        },
        "provider_contract_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Contract Version"
        },
        "query_class": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Class"
        },
        "query_plan_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Plan Hash"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        },
        "service_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Version"
        },
        "snapshot_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snapshot Date"
        },
        "snapshot_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snapshot Id"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        }
      },
      "title": "ProviderProvenanceModel",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorities": {
      "items": {
        "$ref": "#/$defs/ProviderAuthorityCandidate"
      },
      "title": "Authorities",
      "type": "array"
    },
    "capabilities": {
      "additionalProperties": {
        "type": "boolean"
      },
      "title": "Capabilities",
      "type": "object"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "mirror_git_sha": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mirror Git Sha"
    },
    "partial": {
      "default": false,
      "title": "Partial",
      "type": "boolean"
    },
    "provenance": {
      "$ref": "#/$defs/ProviderProvenanceModel"
    },
    "provider_contract_version": {
      "title": "Provider Contract Version",
      "type": "integer"
    },
    "provider_name": {
      "title": "Provider Name",
      "type": "string"
    },
    "research_id": {
      "title": "Research Id",
      "type": "string"
    },
    "service_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Service Version"
    },
    "snapshot_date": {
      "title": "Snapshot Date",
      "type": "string"
    },
    "snapshot_id": {
      "title": "Snapshot Id",
      "type": "string"
    },
    "truncated": {
      "default": false,
      "title": "Truncated",
      "type": "boolean"
    }
  },
  "required": [
    "provider_contract_version",
    "provider_name",
    "snapshot_id",
    "snapshot_date",
    "research_id",
    "capabilities",
    "authorities",
    "limitations",
    "provenance"
  ],
  "title": "ProviderSearchResponseModel",
  "type": "object"
}
