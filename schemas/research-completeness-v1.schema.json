{
  "$defs": {
    "CompletenessStatus": {
      "enum": [
        "NOT_STARTED",
        "IN_PROGRESS",
        "COMPLETE",
        "PARTIAL",
        "UNKNOWN",
        "BLOCKED"
      ],
      "title": "CompletenessStatus",
      "type": "string"
    },
    "DimensionAssessment": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "title": "Basis",
          "type": "string"
        },
        "blocking_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blocking Reason"
        },
        "dimension": {
          "$ref": "#/$defs/ResearchDimension"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/CompletenessStatus"
        },
        "unresolved_questions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unresolved Questions",
          "type": "array"
        }
      },
      "required": [
        "dimension",
        "status",
        "basis"
      ],
      "title": "DimensionAssessment",
      "type": "object"
    },
    "ResearchDimension": {
      "enum": [
        "JURISDICTION",
        "FACTS",
        "PROCEDURAL_POSTURE",
        "CONTROLLING_AUTHORITY",
        "GOVERNING_TEXT",
        "AUTHORITY_HIERARCHY",
        "ADVERSE_AUTHORITY",
        "LIMITING_AUTHORITY",
        "QUOTE_VERIFICATION",
        "CURRENTNESS_TREATMENT",
        "APPLICATION"
      ],
      "title": "ResearchDimension",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assessment_id": {
      "title": "Assessment Id",
      "type": "string"
    },
    "blocked_dimensions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ResearchDimension"
      },
      "title": "Blocked Dimensions",
      "type": "array"
    },
    "contract": {
      "default": "nora.legal-research/ResearchQuality/1.0",
      "title": "Contract",
      "type": "string"
    },
    "dimensions": {
      "items": {
        "$ref": "#/$defs/DimensionAssessment"
      },
      "title": "Dimensions",
      "type": "array"
    },
    "overall_status": {
      "$ref": "#/$defs/CompletenessStatus"
    },
    "required_dimensions": {
      "items": {
        "$ref": "#/$defs/ResearchDimension"
      },
      "title": "Required Dimensions",
      "type": "array"
    },
    "research_id": {
      "title": "Research Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "stop_basis": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Stop Basis",
      "type": "array"
    },
    "stopping_rule_met": {
      "default": false,
      "title": "Stopping Rule Met",
      "type": "boolean"
    },
    "unresolved_dimensions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ResearchDimension"
      },
      "title": "Unresolved Dimensions",
      "type": "array"
    }
  },
  "required": [
    "assessment_id",
    "research_id",
    "dimensions",
    "required_dimensions",
    "overall_status"
  ],
  "title": "ResearchCompleteness",
  "type": "object"
}
